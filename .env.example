# Token del bot de Discord (obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui
BOT_PREFIX=!

# (Opcional) Credenciales de Spotify API (https://developer.spotify.com/dashboard)
# Si se dejan vacías, el bot igualmente reconocerá y extraerá enlaces de Spotify automáticamente.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# (Opcional) Ruta directa al ejecutable de FFmpeg si no está en PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
